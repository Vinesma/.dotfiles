[Unit]
Description=llama.cpp server via Docker Compose
After=docker.service

[Service]
Type=simple
WorkingDirectory=%h/.dotfiles/llama-cpp
EnvironmentFile=%h/.dotfiles/llama-cpp/llama.env
ExecStart=/usr/bin/docker compose --env-file /home/vinesma/.dotfiles/llama-cpp/llama.env up --no-color --abort-on-container-exit
ExecStop=/usr/bin/docker compose --env-file /home/vinesma/.dotfiles/llama-cpp/llama.env down
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target